# ---------------------------------------------------------------------------
# Frontend (Vite) — safe to expose: the anon/publishable key only identifies
# the project; all data access is enforced by Postgres RLS.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---------------------------------------------------------------------------
# Scripts (npm run seed:users / npm run eval) — NEVER expose these to the browser.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# AI provider — set ONE of these (also as edge function secrets, see below).
# OPENAI_API_KEY   → OpenAI directly   (default model gpt-4.1-mini, fallback gpt-4o-mini)
# OPENROUTER_API_KEY → OpenRouter      (default anthropic/claude-haiku-4.5, fallback openai/gpt-4.1-mini)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-v1-...

# ---------------------------------------------------------------------------
# Edge function secrets — set with `npx supabase secrets set KEY=value`.
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# into edge functions automatically by Supabase.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...              (or OPENROUTER_API_KEY=...)
# LLM_PROVIDER=openai                (optional; inferred from which key is set)
# LLM_MODEL=gpt-4.1-mini             (optional)
# LLM_FALLBACK_MODELS=gpt-4o-mini    (optional, comma-separated)
# LLM_PRICE_INPUT_PER_M=0.4          (optional, USD per 1M tokens, for cost logging)
# LLM_PRICE_OUTPUT_PER_M=1.6
# KB_TOP_K=3
# LLM_TIMEOUT_MS=25000
# APP_URL=https://your-app.vercel.app
